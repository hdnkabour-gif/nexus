{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.invalid/contracts/application-manifest/1.0.0",
  "title": "NEXUS Application Discovery Manifest 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "app_id",
    "display_name",
    "category",
    "status",
    "connection_status",
    "owner_team",
    "source",
    "runtime",
    "environments",
    "data_policy",
    "planned_capabilities",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "app_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "display_name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120
    },
    "category": {
      "type": "string",
      "enum": [
        "erp",
        "commerce",
        "rental",
        "services",
        "healthcare",
        "intranet",
        "other"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "discovered",
        "awaiting_authorization",
        "onboarding",
        "active",
        "degraded",
        "suspended",
        "revoked"
      ]
    },
    "connection_status": {
      "type": "string",
      "enum": [
        "not_connected",
        "read_only",
        "governed_actions",
        "suspended"
      ]
    },
    "owner_team": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "repository",
        "default_branch"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "github",
            "gitlab",
            "other"
          ]
        },
        "repository": {
          "type": "string",
          "minLength": 3,
          "maxLength": 250
        },
        "default_branch": {
          "type": "string",
          "minLength": 1
        },
        "observed_commit_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "framework",
        "database",
        "hosting"
      ],
      "properties": {
        "language": {
          "type": "string",
          "minLength": 2
        },
        "framework": {
          "type": "string",
          "minLength": 2
        },
        "database": {
          "type": "string",
          "minLength": 2
        },
        "hosting": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "environments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "classification",
          "provider"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9-]{2,40}$"
          },
          "classification": {
            "enum": [
              "development",
              "staging",
              "pilot",
              "production",
              "unknown"
            ]
          },
          "provider": {
            "type": "string",
            "minLength": 2
          },
          "service_names": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 50
          }
        }
      }
    },
    "data_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "customer_records_allowed",
        "medical_records_allowed"
      ],
      "properties": {
        "classification": {
          "const": "operational_metadata_only"
        },
        "customer_records_allowed": {
          "const": false
        },
        "medical_records_allowed": {
          "const": false
        }
      }
    },
    "planned_capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "risk",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]+$"
          },
          "risk": {
            "enum": [
              "R0",
              "R1",
              "R2",
              "R3",
              "R4"
            ]
          },
          "status": {
            "enum": [
              "planned",
              "implemented",
              "verified",
              "disabled"
            ]
          },
          "description": {
            "type": "string",
            "maxLength": 280
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_type",
        "observed_at",
        "source_ref"
      ],
      "properties": {
        "observation_type": {
          "enum": [
            "source_review",
            "provider_review",
            "operator_attestation",
            "synthetic_example"
          ]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_ref": {
          "type": "string",
          "minLength": 5
        },
        "notes": {
          "type": "string",
          "maxLength": 800
        }
      }
    }
  }
}
