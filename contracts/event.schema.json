{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.invalid/contracts/event/1.0.0",
  "title": "NEXUS Redacted Operational Event 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "app_id",
    "environment",
    "type",
    "severity",
    "occurred_at",
    "observed_at",
    "correlation_id",
    "source",
    "data_classification",
    "attributes"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "app_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "environment": {
      "type": "string",
      "minLength": 2
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{2,120}$"
    },
    "severity": {
      "enum": [
        "info",
        "warning",
        "critical"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 6,
      "maxLength": 120
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "service"
      ],
      "properties": {
        "kind": {
          "enum": [
            "adapter",
            "github",
            "railway",
            "synthetic"
          ]
        },
        "service": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        }
      }
    },
    "data_classification": {
      "const": "operational_metadata_only"
    },
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "type": "string",
          "maxLength": 120
        },
        "outcome": {
          "enum": [
            "pass",
            "fail",
            "unknown"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "category": {
          "type": "string",
          "maxLength": 100
        },
        "duration_ms": {
          "type": "number",
          "minimum": 0
        },
        "provider_code": {
          "type": "string",
          "maxLength": 80
        },
        "deployment_ref": {
          "type": "string",
          "maxLength": 120
        },
        "version": {
          "type": "string",
          "maxLength": 60
        },
        "evidence_ref": {
          "type": "string",
          "maxLength": 240
        }
      }
    },
    "synthetic_example": {
      "type": "boolean"
    }
  }
}
