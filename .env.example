# DO NOT put production values in GitHub.
# Optional owner display name and login alias. Change them in Railway Variables.
NEXUS_ADMIN_NAME=NEXUS Owner
NEXUS_ADMIN_USERNAME=owner
NEXUS_ADMIN_EMAIL=owner@example.invalid
NEXUS_ADMIN_PASSWORD_HASH=scrypt$SALT_HEX$HASH_HEX
# Generate the scrypt value using: npm run owner:hash
# DO NOT create a plaintext NEXUS_ADMIN_PASSWORD environment variable.
NEXUS_SESSION_SECRET=SET_A_UNIQUE_32_PLUS_CHAR_RANDOM_SECRET
# Optional, server-side, dedicated provider tokens with minimum read-only scopes:
NEXUS_GITHUB_READ_TOKEN=
NEXUS_RAILWAY_READ_TOKEN=

# NEXUS-owned PostgreSQL only (separate project/service; no product DB access):
NEXUS_DATABASE_URL=postgresql://nexus:CHOOSE_DATABASE_CREDENTIAL@postgres.railway.internal:5432/nexus
